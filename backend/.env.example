PORT=3001
# For local development, leave TURSO_DATABASE_URL empty to use local bistro.db.
# For persistent cloud hosting (Vercel / Render), set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN from https://app.turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_private_admin_password
APP_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=Bistro Eleven <your-email@gmail.com>
